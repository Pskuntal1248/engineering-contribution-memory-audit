diff -ruN --exclude=.venv --exclude=.gravity --exclude=audit --exclude=build --exclude=__pycache__ --exclude=.pytest_cache --exclude=requirements.lock --exclude=.DS_Store /tmp/uc10-head/src/inputs.py uc10-audit/src/inputs.py
