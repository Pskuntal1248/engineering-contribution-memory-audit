+        run({"backfill_months": months})
+
+
+def test_timezone_is_strict_iana_blank_uses_the_default_and_says_so():
+    for bad in ("IST", "asia/kolkata", "Mars/Base", "UTC+5"):
+        with pytest.raises(ValueError, match="timezone"):
+            run({"timezone": bad})
