+
+def _commit(sha, msg, files=None, date="2026-10-02T10:00:00Z"):
+    raw = {"sha": sha, "author": {"login": "u"}, "commit": {"message": msg, "author": {"name": "u", "date": date}}, "html_url": "x", "parents": [{}], "files": files or []}
+    return N.normalize_commit(raw, "o/r", "u", [])
