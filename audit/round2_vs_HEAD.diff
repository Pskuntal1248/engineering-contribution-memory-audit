+    level: Literal["current", "next"] = Field(description="current = asked at the user's current level; next = asked at the next level up")
+
+
+class ExtractedFramework(BaseModel):
+    expectations: list[ExtractedExpectation]
+
+
+MAX_EXPECTATIONS = 40
+
+
+def framework_hash(text: str, role_and_level: str) -> str:
+    return hashlib.sha256((role_and_level.strip().lower() + "\n" + text.strip()).encode()).hexdigest()[:16]
+
+
+async def extract_with_model(llm, budget, framework: str, role_and_level: str) -> tuple[list["Expectation"], str]:
+    """Expectations from a framework written as prose. Every extracted line must be grounded in the framework text (most of its words appear
+    there), so the model cannot invent an expectation. Returns (expectations, reason) - the reason is empty on success."""
+    system = ("You read a company career ladder / review framework. List the expectations it states, each as one short line, worded as in the text. "
+              "level=current for expectations at the user's current level, level=next for the level above it; if the text does not separate levels, use next. "
+              "Use ONLY the given text. Do not add, merge or invent expectations.")
+    try:
+        res = await llm.structured(ExtractedFramework, system, {"role_and_level": role_and_level, "framework_text": framework[:12000]}, budget)
+    except BudgetExceeded as e:
+        return [], f"the model limit was reached before the framework could be read ({e})"
+    except Exception as e:  # noqa: BLE001
+        return [], f"the model call failed ({str(e)[:120]})"
+    src = set(tokens(framework))
+    out: list[Expectation] = []
+    seen: set[str] = set()
+    for x in getattr(res, "expectations", []):
+        t = re.sub(r"\s+", " ", x.text).strip().rstrip(".")
+        tt = set(tokens(t))
+        if not t or t.lower() in seen or not tt or len(tt & src) / len(tt) < 0.6:
+            continue  # not in the document: dropped
+        seen.add(t.lower())
+        out.append(Expectation(f"E{len(out)+1}", x.level, t))
+        if len(out) >= MAX_EXPECTATIONS:
+            break
+    if not out:
+        return [], "the model returned no expectation that appears in the framework text"
+    return out, ""
+
