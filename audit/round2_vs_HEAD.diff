+def test_semicolons_are_rejected_commas_and_newlines_work():
+    for k in ("repos_or_org", "jira_projects", "slack_channels", "slack_user_ids"):
+        with pytest.raises(ValueError, match=k):
+            run({k: "a/b;c/d" if k == "repos_or_org" else "a;b"})
